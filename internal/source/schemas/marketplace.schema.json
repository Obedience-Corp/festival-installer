{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "schema_version", "packages"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "schema_version": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string" },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "class"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "class": {
            "type": "string",
            "enum": ["product", "tool", "plugin", "bundle"]
          },
          "summary": { "type": "string" },
          "host_runtimes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "runtime"],
              "properties": {
                "package": { "type": "string", "minLength": 1 },
                "runtime": { "type": "string", "minLength": 1 },
                "version_constraint": { "type": "string" },
                "required_features": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "channels": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "manifest_path": { "type": "string", "minLength": 1 },
          "release_source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "repo", "asset_url", "checksums_url"],
            "properties": {
              "type": { "type": "string", "enum": ["git"] },
              "repo": { "type": "string", "minLength": 1 },
              "asset_url": { "type": "string", "minLength": 1 },
              "checksums_url": { "type": "string", "minLength": 1 },
              "binary": { "type": "string" },
              "os": { "type": "object", "additionalProperties": { "type": "string" } },
              "arch": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    },
    "extensions": { "type": "object" }
  }
}
