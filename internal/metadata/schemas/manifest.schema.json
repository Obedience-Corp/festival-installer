{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "class", "display_name", "summary", "releases"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "class": { "type": "string", "enum": ["product", "tool", "plugin", "bundle"] },
    "display_name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "homepage": { "type": "string" },
    "licenses": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "supported_scopes": {
      "type": "array",
      "items": { "type": "string", "enum": ["user", "campaign"] }
    },
    "provides_binaries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "host_runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime"],
        "properties": {
          "runtime": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string" },
          "features": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "runtime"],
        "properties": {
          "package": { "type": "string", "minLength": 1 },
          "runtime": { "type": "string", "minLength": 1 },
          "version_constraint": { "type": "string", "pattern": "^(>=|<=|>|<|=)?\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
          "required_features": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "channel", "published_at", "compatibility", "dependencies", "artifacts", "install"],
        "properties": {
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
          "channel": { "type": "string", "minLength": 1 },
          "published_at": { "type": "string", "format": "date-time" },
          "components": { "type": "object", "additionalProperties": { "type": "string" } },
          "provides_binaries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "arch"],
            "properties": {
              "os": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["darwin", "linux"] } },
              "arch": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["amd64", "arm64"] } }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "version_constraint"],
              "properties": {
                "package": { "type": "string", "minLength": 1 },
                "version_constraint": { "type": "string", "pattern": "^(>=|<=|>|<|=)?\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
                "scope": { "type": "string", "enum": ["user", "campaign"] }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "os", "arch", "url", "sha256"],
              "properties": {
                "kind": { "type": "string", "enum": ["suite-archive", "tar.gz", "binary"] },
                "os": { "type": "string", "enum": ["darwin", "linux"] },
                "arch": { "type": "string", "enum": ["amd64", "arm64", "all"] },
                "url": { "type": "string", "format": "uri" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "filename": { "type": "string" },
                "binaries": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "install": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entries"],
            "properties": {
              "entries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "source"],
                  "properties": {
                    "kind": { "type": "string", "enum": ["binary", "extension_dir", "skill_bundle"] },
                    "source": { "type": "string", "minLength": 1 },
                    "executable_name": { "type": "string" },
                    "extension_name": { "type": "string" },
                    "skill_slug": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extensions": { "type": "object" }
  }
}
